MC_HOST=localhost
MC_PORT=25565
# MC_USERNAME is the bot name when BOTS=1
MC_USERNAME=YazoniBot
MC_AUTH=offline
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
OWNER_USERNAME=Yazoni
BOT_NAME=YazoniBot
BOT_PERSONALITY=Funny, quick-witted Minecraft companion for videos. Be playful, occasionally sarcastic, react to chaos, but never become annoying or spammy.
THINK_INTERVAL_MS=12000
MAX_PLAN_STEPS=8
AUTO_FOLLOW=true
FOLLOW_DISTANCE=5
# --- multiple bots ---
# BOTS=1 behaves like before. Set BOTS=3 (up to 20) to run several bots from one process.
BOTS=3
# Optional comma-separated names (max 16 chars each); defaults to Vexor,Kairo,Zyph,Riven,Nyx,Drax,Soren,Kryo,Taz,Mako
# BOT_NAMES=Vexor,Kairo,Zyph
JOIN_DELAY_MS=6000
# All bots share one Gemini queue: min gap between calls, and max backlog before extra calls are dropped
GEMINI_MIN_GAP_MS=4000
GEMINI_MAX_QUEUE=6
